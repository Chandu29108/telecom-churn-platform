DATABASE_URL=postgresql+psycopg2://churn_user:churn_pass@db:5432/churn_db
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
CHURN_THRESHOLD=0.45
MODEL_DIR=/app/storage/models
UPLOAD_DIR=/app/storage/uploads

# --- Auth / multi-tenancy ---
ENVIRONMENT=development
# Generate a real value before deploying: python -c "import secrets; print(secrets.token_hex(32))"
# main.py refuses to start in production with the placeholder below.
SECRET_KEY=dev-secret-change-me-before-deploying
# Short by design (Phase 1 auth hardening) — a rotating httpOnly-cookie
# refresh token backs it, so this being short costs no UX but caps how
# long a leaked access token stays useful. See app/routers/auth.py.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Email (verification + password reset) ---
# console (default): logs the email + link instead of sending it — no
# credentials needed for local dev/CI. Set to `resend` + RESEND_API_KEY to
# send real email. See app/email/resend_provider.py for why Resend was
# picked for this stack.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@yourdomain.example
# Used to build the links inside verification/reset emails.
FRONTEND_URL=http://localhost:5173

# --- LLM copilot (free/local by default via Ollama) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Smaller/faster option for lower-spec machines: llama3.2:1b
OLLAMA_MODEL=llama3.1

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_AUTH=10/minute

# --- Model storage (Cloudflare R2) ---
# Optional. Leave all four blank for local-disk storage (fine for dev, NOT
# safe in production on platforms with an ephemeral filesystem like
# Render's web service disk — model files vanish on every redeploy/restart).
# Set all four to switch to Cloudflare R2 (free tier: 10GB, no egress fees):
#   1. Create a Cloudflare account -> R2 -> create a bucket.
#   2. R2 -> Manage API Tokens -> create a token with read/write access to
#      that bucket. This gives you the access key ID + secret access key.
#   3. R2_ACCOUNT_ID is shown on the R2 overview page in the dashboard.
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Upload hardening, part 2 ---
MAX_UPLOAD_COLUMNS=500

# --- Background jobs ---
MAX_JOB_RETRIES=3
JOB_STALE_AFTER_MINUTES=30

# --- Observability (optional) ---
SENTRY_DSN=
